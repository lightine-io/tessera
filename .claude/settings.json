{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git push *)",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/private-content-scan.sh",
            "statusMessage": "Scanning for private content before push..."
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/block-screenshot.sh"
          },
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/prefer-dev-wrappers.sh"
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/gh-content-scan.sh",
            "statusMessage": "Scanning outward gh content for private terms..."
          }
        ]
      },
      {
        "matcher": "mcp__youtrack__(create|update|add|change|link|log|manage)_.*",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/mark-substantive.sh"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/stop-handoff-check.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/scripts/standing-obligations.sh"
          }
        ]
      }
    ]
  }
}
