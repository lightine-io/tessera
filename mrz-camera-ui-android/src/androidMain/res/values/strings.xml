<?xml version="1.0" encoding="utf-8"?>
<!--
  User-facing copy for the default MRZ scanner screen (MrzScannerScreen).

  These `tessera_*` keys are a PUBLIC, OVERRIDABLE contract: a consumer app can translate or rebrand any
  label simply by defining a string with the SAME key in its own `res/values*/strings.xml`. Android's
  resource merge prefers the application's resource over a library's, so the consumer's value wins with no
  API surface involved. The consumer-facing how-to lives in the default-UI feature article (tracked as
  TES-53); until then this contract is documented here and in the MrzScannerScreen KDoc.

  Because they are a contract, the KEY SET freezes at the 0.5.0 tag (ADR-007). Keep it small and stable;
  add a key only for genuinely new user-facing copy, and never rename or remove an existing key without a
  deprecation. The `tessera_scanner_` prefix namespaces them to avoid colliding with a consumer's own keys.

  Positional format args (%1$s etc.) are used so a translation can reorder them; the `formatted="false"`
  attribute is deliberately omitted since every templated string uses positional (not implicit) args.
-->
<resources>
    <!-- Guidance shown over the live camera preview while scanning. -->
    <string name="tessera_scanner_camera_hint">Point the camera at the document\'s data page</string>

    <!-- ============================ Struggling hint (mockup 02) ============================ -->
    <!-- Shown over the live preview after a while with no successful read. Advisory only — it nudges the
         user to improve the capture; it is never an error and never a verdict about the document (Principle 1). -->
    <string name="tessera_scanner_struggling_hint">Still looking — try more light or move closer</string>
    <!-- The "type it instead" affordance on the struggling hint — the escape into manual entry. -->
    <string name="tessera_scanner_struggling_manual">Type it instead</string>

    <!-- ============================ Camera-status screens (mockups 05 / 05b) ============================ -->
    <!-- Camera in use (recoverable, mockup 05): another app holds the camera; the session stays bound and the
         platform framework reconnects on its own, so there is no retry — only the manual-entry escape. -->
    <string name="tessera_scanner_camera_in_use_title">Camera is in use</string>
    <string name="tessera_scanner_camera_in_use_body">Another app is using the camera — it will reconnect automatically.</string>
    <!-- The recoverable status, stated in words beside the pulsing indicator (the meaning is in the text). -->
    <string name="tessera_scanner_camera_reconnecting">Reconnecting…</string>
    <!-- Camera unavailable (terminal, mockup 05b): the camera cannot be started at all; no retry. -->
    <string name="tessera_scanner_camera_unavailable_title">Camera unavailable</string>
    <string name="tessera_scanner_camera_unavailable_body">This device\'s camera can\'t be started. You can still enter the document details by hand.</string>
    <!-- Shared action on both camera-status screens AND both permission screens (04 / 04b): switch to
         typing the details by hand. -->
    <string name="tessera_scanner_camera_manual">Enter details manually</string>
    <!-- Dismisses the scanner; the flow reports Cancelled. -->
    <string name="tessera_scanner_cancel">Cancel</string>

    <!-- ============================ Adaptive camera-permission screen (mockups 04 / 04b) ============================ -->
    <!-- ONE adaptive screen whose primary action tracks the permission status. While a request can still
         succeed it is "Grant mode" (04): the host is handed the request (the SDK never requests a permission
         itself, scope permission boundary). Once permanently denied it is "Settings mode" (04b): the only way
         to grant is the OS app-settings screen, which the UI opens by Intent (navigation, not a permission
         request). Both share the secondary "Enter details manually" escape above and the on-device privacy
         line — the SDK reads the MRZ locally and never uploads or stores the document. -->

    <!-- Grant mode (04) — a request can still succeed. -->
    <!-- Title shown while the camera permission is not yet held but can still be requested. -->
    <string name="tessera_scanner_permission_grant_title">Camera permission needed</string>
    <!-- Body: why the permission is needed, stated with the on-device privacy fact. -->
    <string name="tessera_scanner_permission_grant_body">The scanner reads the machine-readable zone on-device; it does not store or upload your document.</string>
    <!-- Primary action: hand the permission request to the host app (the SDK never requests it itself). -->
    <string name="tessera_scanner_permission_grant_action">Grant access</string>

    <!-- Settings mode (04b) — the permission is permanently denied; only the OS settings can grant it. -->
    <!-- Title shown once the camera permission is permanently denied ("don't ask again"). -->
    <string name="tessera_scanner_permission_denied_title">Camera access is off</string>
    <!-- Body: how to re-enable via Settings, with the same on-device privacy fact. -->
    <string name="tessera_scanner_permission_denied_body">Turn on Camera for this app in Settings to scan. The scanner reads the machine-readable zone on-device; it does not store or upload your document.</string>
    <!-- Primary action: open this app's OS settings page so the user can turn Camera on (navigation, not a
         permission request). -->
    <string name="tessera_scanner_permission_open_settings">Open Settings</string>

    <!-- Retained for backward compatibility (the tessera_* key set is a frozen public contract, ADR-007): the
         earlier single-prompt permission copy. No longer shown by the adaptive screen above, kept so a
         consumer that already overrode these keys is not broken. -->
    <!-- Explains why the camera permission is needed, shown when it is not yet granted. -->
    <string name="tessera_scanner_permission_rationale">Camera permission is needed to scan the document</string>
    <!-- Action that hands the permission request to the host app (the SDK never requests it itself). -->
    <string name="tessera_scanner_grant_permission">Grant camera access</string>

    <!-- ============================ Review screen (mockups 03 / 03b / 03c) ============================ -->

    <!-- Review screen title, shown when an MRZ decoded and is up for the user to accept or rescan. Not a
         "valid" verdict — the SDK reports what it read, the user decides (Principle 1). -->
    <string name="tessera_scanner_review_title">MRZ read</string>
    <!-- Header over the review screen's summary rows (document, name, number, expiry). -->
    <string name="tessera_scanner_review_observations_header">Observations</string>
    <!-- Disclosure that opens the full parsed field set and the raw MRZ lines (mockup 03c). -->
    <string name="tessera_scanner_review_show_all">Show all fields &amp; raw MRZ ▾</string>
    <!-- Primary action: accept this reading as-is. Stays enabled even on a check-digit mismatch — the SDK
         reports the mismatch and lets the consumer decide; it never blocks or auto-corrects (Principle 1). -->
    <string name="tessera_scanner_review_use">Use this result</string>
    <!-- Secondary action: discard this reading and go back to scanning. -->
    <string name="tessera_scanner_review_rescan">Rescan</string>

    <!-- Expanded all-fields view title (mockup 03c). -->
    <string name="tessera_scanner_review_all_fields_title">All fields</string>
    <!-- Header over the raw MRZ lines in the expanded view. -->
    <string name="tessera_scanner_review_raw_mrz_header">Raw MRZ</string>

    <!-- Field labels for the summary rows and the expanded all-fields view. -->
    <string name="tessera_scanner_field_document">Document</string>
    <string name="tessera_scanner_field_document_type">Document type</string>
    <string name="tessera_scanner_field_name">Name</string>
    <string name="tessera_scanner_field_number">Number</string>
    <string name="tessera_scanner_field_expiry">Expiry</string>
    <string name="tessera_scanner_field_issuing_state">Issuing state</string>
    <string name="tessera_scanner_field_nationality">Nationality</string>
    <string name="tessera_scanner_field_date_of_birth">Date of birth</string>
    <string name="tessera_scanner_field_sex">Sex</string>
    <string name="tessera_scanner_field_optional">Personal / optional no.</string>

    <!-- Name row value: "%1$s" is the primary identifier (surname), "%2$s" the secondary (given names). -->
    <string name="tessera_scanner_name_format">%1$s, %2$s</string>
    <!-- Document row value: "%1$s" is the raw type code, "%2$s" the recognized category (e.g. "P — passport"). -->
    <string name="tessera_scanner_document_format">%1$s — %2$s</string>

    <!-- Human-readable document categories (the recognized category is shown alongside the raw type code). -->
    <string name="tessera_scanner_category_passport">passport</string>
    <string name="tessera_scanner_category_identity_card">identity card</string>
    <string name="tessera_scanner_category_residence_permit">residence permit</string>
    <string name="tessera_scanner_category_visa">visa</string>
    <string name="tessera_scanner_category_other">other</string>

    <!-- ================================ Observations (per check digit / date / provenance) ================================ -->
    <!-- These are stated observations, never a "valid" verdict. -->

    <!-- A check digit recorded on the document matches the value the SDK computes. "%1$s" is the field
         label (e.g. "Document number"). Rendered with a ✓ mark. -->
    <string name="tessera_scanner_obs_check_match">%1$s check digit matches</string>
    <!-- A recorded check digit does NOT match the computed value. "%1$s" is the field label, "%2$s" the
         digit recorded on the document, "%3$s" the digit the SDK computes. Rendered with a ‼ mark. Neither
         value is "wrong" — the SDK states both and the consumer decides (Principle 1). -->
    <string name="tessera_scanner_obs_check_mismatch">%1$s check digit: recorded %2$s, computed %3$s</string>
    <!-- The expiry components form a real calendar date. "%1$s" is that date. Rendered with a ✓ mark. -->
    <string name="tessera_scanner_obs_expiry_well_formed">Expiry %1$s is a well-formed date</string>
    <!-- Neutral advisory shown when one or more checks did not match — it points at the document, it does
         not pass judgement. Rendered with a ⓘ mark. -->
    <string name="tessera_scanner_obs_some_mismatch">Some checks did not match — verify against the document.</string>
    <!-- Provenance line: how the SDK read this document. "%1$s" is the read-method label below. Rendered
         with a ⓘ mark. -->
    <string name="tessera_scanner_obs_read_by">Read by %1$s</string>

    <!-- Read-method labels used in the provenance observation. -->
    <string name="tessera_scanner_read_method_live_camera">live camera</string>
    <string name="tessera_scanner_read_method_photo">photo</string>
    <string name="tessera_scanner_read_method_manual">manual entry</string>

    <!-- Field labels for the check-digit observations (which check digit the observation is about). -->
    <string name="tessera_scanner_check_label_document_number">Document number</string>
    <string name="tessera_scanner_check_label_date_of_birth">Date of birth</string>
    <string name="tessera_scanner_check_label_date_of_expiry">Expiry</string>
    <string name="tessera_scanner_check_label_optional_data">Personal / optional no.</string>
    <string name="tessera_scanner_check_label_composite">Composite</string>

    <!-- Scan-quality line in the expanded view. "%1$s" is the region status, "%2$s" the OCR confidence,
         "%3$s" the recognized line count. Rendered with a ⓘ mark. Informational only, never a gate. -->
    <string name="tessera_scanner_quality_format">Scan quality: region %1$s · OCR confidence %2$s · lines: %3$s</string>
    <!-- Region status values for the quality line. -->
    <string name="tessera_scanner_quality_region_found">found</string>
    <string name="tessera_scanner_quality_region_not_found">not found</string>
    <!-- Placeholder for an OCR confidence the engine did not report. -->
    <string name="tessera_scanner_quality_confidence_unknown">n/a</string>

    <!-- Accessibility content-description prefixes so an observation's tone (match / mismatch / info) is
         conveyed to a screen reader, not carried by colour alone. Prepended to the observation text. -->
    <string name="tessera_scanner_obs_tone_match">Match:</string>
    <string name="tessera_scanner_obs_tone_mismatch">Attention:</string>
    <string name="tessera_scanner_obs_tone_info">Note:</string>

    <!-- ============================ Read-failed screen (mockup 08) ============================ -->

    <!-- Title shown when OCR text did not parse as any known MRZ format. Never "invalid" — the SDK could
         not read it, which is a different, honest statement. -->
    <string name="tessera_scanner_read_failed_title">Couldn\'t read this MRZ</string>
    <!-- Explains the likely cause without judging the document. -->
    <string name="tessera_scanner_read_failed_body">The text didn\'t match a known MRZ format — it may be blurred or partial.</string>
    <!-- Header over the verbatim captured OCR text (garbles preserved, Principle 5). -->
    <string name="tessera_scanner_read_failed_captured_header">Captured text</string>
    <!-- Primary action: go back to scanning and try to read again. -->
    <string name="tessera_scanner_read_failed_try_again">Try again</string>
    <!-- Secondary action: switch to typing the details by hand (manual entry, TES-63). -->
    <string name="tessera_scanner_read_failed_manual">Enter details manually</string>

    <!-- ============================ Manual raw-MRZ entry screen (mockup 06) ============================ -->

    <!-- Title of the manual raw-MRZ entry screen — the user types the MRZ lines exactly as printed. -->
    <string name="tessera_scanner_manual_title">Type the MRZ</string>
    <!-- Label / placeholder for the multi-line monospace MRZ text field. -->
    <string name="tessera_scanner_manual_field_label">MRZ lines</string>

    <!-- Format-hint chips. These pick which parser runs; they are hints ONLY and never rewrite what the
         user typed (reader, not oracle — Principle 1). -->
    <string name="tessera_scanner_manual_hint_auto">Auto</string>
    <string name="tessera_scanner_manual_hint_passport">Passport</string>
    <string name="tessera_scanner_manual_hint_id_card">ID card</string>

    <!-- Live length observations (all ⓘ INFO tone, never a verdict). Auto mode states only the character
         count ("%1$s" is the line number, "%2$s" its character count); when a format chip fixes an expected
         length, a line that differs states the neutral delta ("%1$s" line number, "%2$s" the difference).
         Never "invalid", never an auto-correction. -->
    <string name="tessera_scanner_manual_obs_char_count">Line %1$s: %2$s chars</string>
    <string name="tessera_scanner_manual_obs_short">Line %1$s is %2$s characters short</string>
    <string name="tessera_scanner_manual_obs_over">Line %1$s is %2$s characters over</string>
    <!-- The standing note that the format chips are hints, not fixes — always shown so the honesty is
         never implicit. -->
    <string name="tessera_scanner_manual_obs_hint_note">Format chips are parser hints, not fixes — nothing is auto-corrected</string>

    <!-- Privacy line: the read happens on-device; nothing typed is uploaded or stored. -->
    <string name="tessera_scanner_manual_privacy">Read on this device. The SDK never uploads or stores what you type.</string>
    <!-- Primary action: parse the text the user typed (with the selected format hint). -->
    <string name="tessera_scanner_manual_read">Read what I typed</string>

    <!-- ============================ Saved-image (photo) screens (mockups 07c / 07 / 07b) ============================ -->

    <!-- Analyzing screen (mockup 07c): shown while the picked photo is read on-device. -->
    <string name="tessera_scanner_saved_image_analyzing_title">Analyzing photo…</string>
    <!-- What the analysis is doing, stated plainly. -->
    <string name="tessera_scanner_saved_image_analyzing_reading">Reading the machine-readable zone</string>
    <!-- Privacy fact under the analyzing indicator: the read is entirely on-device. -->
    <string name="tessera_scanner_saved_image_analyzing_on_device">On-device — the photo is not uploaded.</string>

    <!-- Candidates screen (mockup 07): tolerant reading resolved an ambiguous glyph more than one way, so
         EVERY parseable reading is shown for the user to choose among — nothing is chosen for them
         (Principle 1 / ADR-023). -->
    <string name="tessera_scanner_saved_image_candidates_title">From photo</string>
    <!-- Intro over the candidate list. "%1$d" is the number of readings found. The bold-differing-character
         note refers to the emphasised glyph on each candidate. "Nothing is chosen for you" is the honest
         reader-not-oracle statement — the SDK surfaces every reading and never picks one. -->
    <string name="tessera_scanner_saved_image_candidates_intro">Found %1$d possible readings. An ambiguous character differs (bold below) — pick the one matching your document. Nothing is chosen for you.</string>
    <!-- Per-candidate action: accept THIS reading. Enabled for every candidate regardless of its check-digit
         verdict — the user decides which reading is theirs (reader, not oracle, Principle 1). -->
    <string name="tessera_scanner_saved_image_use_this">Use this ›</string>
    <!-- Spoken note appended to a highlighted MRZ line so the differing glyph is conveyed to a screen reader,
         not carried by the bold/colour emphasis alone (non-colour a11y). -->
    <string name="tessera_scanner_saved_image_differs_here">differs here</string>

    <!-- Empty screen (mockup 07b): no MRZ could be located in the picked photo. Never "invalid" — the zone
         couldn't be found, which is a different, honest statement. -->
    <string name="tessera_scanner_saved_image_empty_title">No MRZ found in this photo</string>
    <string name="tessera_scanner_saved_image_empty_body">The machine-readable zone couldn\'t be located in this image. Use a printed document\'s data page — screens and low-contrast copies often don\'t read.</string>
    <!-- Privacy note on the empty screen: the photo never leaves the device. -->
    <string name="tessera_scanner_saved_image_empty_privacy">The photo stays on your device. This SDK doesn\'t upload or store it.</string>

    <!-- Shared saved-image actions. -->
    <!-- Pick a different photo (re-launch the picker). -->
    <string name="tessera_scanner_saved_image_choose_different">Choose different photo</string>
    <!-- Escape from the empty screen into manual entry. -->
    <string name="tessera_scanner_saved_image_manual">Enter details manually</string>
</resources>
